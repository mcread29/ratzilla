{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tty0-vfx-editor",
  "version": "0.1.0",
  "identifier": "com.tty0.vfx.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "tty0 VFX Editor",
        "width": 1680,
        "height": 1040,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
